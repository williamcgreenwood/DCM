node_modules/
.project_id
.github_repo
.env
.env.*
.vercel/
.grok/preview.log

**/__pycache__/
*.pyc
dcm_v6/INBOX/*.har
dcm_v6/INBOX/*.json
!dcm_v6/INBOX/README.md
dcm_v6/RUNS/**
!dcm_v6/RUNS/.gitkeep
dcm_v6/canonical_mount/v5.4.1_copy/**
!dcm_v6/canonical_mount/v5.4.1_copy/.gitkeep

# GitHub-verifiable run audits (no HARs, no sqlite).
!audit/
!audit/**
!audit/runs/
!audit/runs/**

# Raw capture safety: never commit live HAR/session material.
*.har
*.har.gz
*.har.zip
*.har.json
**/raw_har/**
**/raw_capture/**
**/captures/private/**
**/INBOX/**
!**/INBOX/README.md

# Runtime artifacts are reproducible and may contain derived user data.
**/RUNS/**
!**/RUNS/.gitkeep

# Sanitized live HAR fixtures (no cookies/tokens) are allowed for parser certification.
!fixtures/sanitized_live_har/
!fixtures/sanitized_live_har/**
!**/fixtures/sanitized_live_har/
!**/fixtures/sanitized_live_har/**
!artifacts/dcm_v6_workstream_ab/fixtures/sanitized_live_har/
!artifacts/dcm_v6_workstream_ab/fixtures/sanitized_live_har/**

.venv/
venv/
*.egg-info/
artifacts/**/*.egg-info/

# Stale portable blobs are not a release channel.
artifacts/dcm_v6_workstream_ab.zip

# Portable release outputs (rebuild with python -m dcm.release)
dist/
artifacts/release/
build/
*.whl

# Never commit trained-weight blobs. P6 learning is JSONL/JSON only.
*.pkl
*.joblib
