{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pillars-dcm.local/schemas/SignalOperatorSpec.schema.json",
  "title": "SignalOperatorSpec",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "operator_id", "version", "stage", "family", "sports",
    "required_inputs", "outputs", "transformation_id", "lifecycle_state",
    "can_change_probability_directly", "can_override_hard_gate"
  ],
  "properties": {
    "operator_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "stage": {
      "enum": ["RESEARCH_TRUTH", "FEATURE", "DIAGNOSTIC", "HARD_GATE", "PORTFOLIO", "LEARNING"]
    },
    "family": {"type": "string", "minLength": 1},
    "sports": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "competitions": {"type": "array", "items": {"type": "string"}},
    "market_definitions": {"type": "array", "items": {"type": "string"}},
    "semantic_scopes": {"type": "array", "items": {"type": "string"}},
    "required_inputs": {"$ref": "#/$defs/fields"},
    "outputs": {"$ref": "#/$defs/fields"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "overlap_group": {"type": "string"},
    "transformation_id": {"type": "string", "minLength": 1},
    "execution_cost_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "lifecycle_state": {
      "enum": [
        "CANDIDATE", "SHADOW_DIAGNOSTIC", "ACTIVE_FEATURE", "ACTIVE_HARD_GATE",
        "DEFERRED", "REJECTED_INVALID", "REJECTED_DUPLICATE"
      ]
    },
    "consumers": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "can_change_probability_directly": {"const": false},
    "can_override_hard_gate": {"const": false}
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "unit", "dimension"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "minLength": 1},
        "temporal_class": {"enum": ["PRE_CUTOFF", "IMMUTABLE_HISTORICAL"]},
        "normalized": {"const": true}
      }
    },
    "fields": {
      "type": "array",
      "items": {"$ref": "#/$defs/field"}
    }
  }
}
