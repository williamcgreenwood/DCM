{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pillars.dcm/schemas/AlgorithmRequirement.schema.json",
  "title": "Pillars DCM Algorithm Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm_id",
    "canonical_name",
    "algorithm_family",
    "lifecycle",
    "applicability_contract",
    "input_contract",
    "output_contract",
    "semantic_scope",
    "implementation_module",
    "implementation_symbol",
    "runtime_producer",
    "runtime_consumer",
    "determinism_class",
    "portability_class",
    "benchmark_ids",
    "test_ids",
    "requirement_trace_ids",
    "introduced_version"
  ],
  "properties": {
    "algorithm_id": {
      "type": "string",
      "pattern": "^ALG-(SEARCH|INDEX|SORT|GROUP|GRAPH|SCHED|CACHE|ML-TABULAR|ML-TIME|ML-CAUSAL|ML-PROB|CAL|UNCERTAINTY|FM)-[0-9]{3}$"
    },
    "canonical_name": { "type": "string", "minLength": 1 },
    "algorithm_family": {
      "type": "string",
      "enum": [
        "SEARCH",
        "INDEX",
        "SORT",
        "GROUP",
        "GRAPH",
        "SCHED",
        "CACHE",
        "ML_TABULAR",
        "ML_TIME",
        "ML_CAUSAL",
        "ML_PROB",
        "CAL",
        "UNCERTAINTY",
        "FM"
      ]
    },
    "lifecycle": {
      "type": "string",
      "enum": ["REQUIRED_CORE", "REQUIRED_CONDITIONAL", "PERMANENT_CHALLENGER"]
    },
    "applicability_contract": { "type": "string", "minLength": 1 },
    "input_contract": { "type": "string", "minLength": 1 },
    "output_contract": { "type": "string", "minLength": 1 },
    "semantic_scope": { "type": "string", "minLength": 1 },
    "implementation_module": { "type": "string", "minLength": 1 },
    "implementation_symbol": { "type": "string", "minLength": 1 },
    "runtime_producer": { "type": "string", "minLength": 1 },
    "runtime_consumer": { "type": "string", "minLength": 1 },
    "fallback_algorithm_id": { "type": ["string", "null"] },
    "dependency_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "determinism_class": { "type": "string", "minLength": 1 },
    "time_complexity_expectation": { "type": "string" },
    "memory_complexity_expectation": { "type": "string" },
    "token_cost_expectation": { "type": "string" },
    "storage_cost_expectation": { "type": "string" },
    "portability_class": {
      "type": "string",
      "enum": ["STDLIB", "SQLITE", "OPTIONAL_PACKAGE", "NOT_PORTABLE_CHALLENGER"]
    },
    "benchmark_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "test_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "audit_event_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirement_trace_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "introduced_version": { "type": "string", "minLength": 1 },
    "superseding_adr": { "type": ["string", "null"] },
    "retired_version": { "type": ["string", "null"] },
    "registry_record_hash": { "type": "string" }
  }
}
